{
  "cleanupPeriodDays": 365,
  "skillListingBudgetFraction": 0.02,
  "permissions": {
    "allow": [
      "Bash(grep:*)",
      "Bash(./gradlew:*)",
      "Bash(../gradlew test:*)",
      "Bash(../gradlew clean:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(git add:*)",
      "Bash(git stash:*)",
      "Bash(git mv:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git log:*)",
      "Bash(git revert:*)",
      "Bash(git reset:*)",
      "Bash(git diff-tree:*)",
      "Bash(git checkout:*)",
      "Bash(git apply:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(md5:*)",
      "Bash(mkdir:*)",
      "Bash(xxd:*)",
      "Bash(unzip:*)",
      "Bash(jar -tf:*)",
      "Bash(jar tf:*)",
      "Bash(jar xf:*)",
      "Bash(javap:*)",
      "Bash(buf:*)",
      "Bash(brew list:*)",
      "Bash(brew info:*)",
      "Bash(brew search:*)",
      "Read(//tmp/**)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:buf.build)",
      "WebFetch(domain:man.archlinux.org)"
    ],
    "deny": [
      "mcp__datadog__create_datadog_notebook",
      "mcp__datadog__edit_datadog_notebook",
      "mcp__datadog__upsert_datadog_dashboard",
      "mcp__datadog__submit_mcp_feedback"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/pre-gh-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/post-git-push.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": false,
    "context7@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "kotlin-lsp@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "atlassian@claude-plugins-official": false,
    "slack@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "agent-browser@agent-browser": false,
    "skill-creator@claude-plugins-official": false,
    "swift-lsp@claude-plugins-official": false,
    "github@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "serena@claude-plugins-official": false,
    "supabase@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "commit-commands@claude-plugins-official": false,
    "chrome-devtools-mcp@claude-plugins-official": false,
    "humanize-korean@im-not-ai": false,
    "codex@openai-codex": true,
    "claude-mem@thedotmack": false,
    "open-code-review@open-code-review": false,
    "korean-skills@korean-skills": true
  },
  "extraKnownMarketplaces": {
    "agent-browser": {
      "source": {
        "source": "github",
        "repo": "vercel-labs/agent-browser"
      }
    },
    "prompts.chat": {
      "source": {
        "source": "github",
        "repo": "f/prompts.chat"
      }
    },
    "im-not-ai": {
      "source": {
        "source": "github",
        "repo": "epoko77-ai/im-not-ai"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "open-code-review": {
      "source": {
        "source": "github",
        "repo": "alibaba/open-code-review"
      }
    },
    "korean-skills": {
      "source": {
        "source": "github",
        "repo": "daleseo/korean-skills"
      }
    }
  },
  "language": "korean",
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "advisorModel": "fable",
  "tui": "fullscreen",
  "autoMemoryDirectory": "~/.claude/memory-shared",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "editorMode": "vim",
  "verbose": true,
  "teammateMode": "in-process",
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "soft_deny": [
      "$defaults"
    ]
  }
}
